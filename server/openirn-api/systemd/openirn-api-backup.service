[Unit]
Description=OpenIRN secure MariaDB backup
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
EnvironmentFile=/etc/openirn-api.env
WorkingDirectory=/opt/openirn-api
ExecStart=/opt/openirn-api/.venv/bin/python /opt/openirn-api/tools/backup_mariadb.py --verbose
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/openirn-api
