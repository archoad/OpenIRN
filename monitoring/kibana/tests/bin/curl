#!/usr/bin/env bash
set -euo pipefail

method='GET'
output=''
write_out=''
url=''

while (($# > 0)); do
	case $1 in
		-X|--request)
			method=$2
			shift 2
			;;
		-o|--output)
			output=$2
			shift 2
			;;
		-w|--write-out)
			write_out=$2
			shift 2
			;;
		--config|-H|--header|--data-binary)
			shift 2
			;;
		--fail|--fail-with-body|--silent|--show-error)
			shift
			;;
		http://*|https://*)
			url=$1
			shift
			;;
		*)
			echo "Argument curl simulé non pris en charge : $1" >&2
			exit 2
			;;
	esac
done

if [[ -z ${url} || -z ${FAKE_CURL_LOG:-} ]]; then
	echo 'URL ou FAKE_CURL_LOG absent du test.' >&2
	exit 2
fi
printf '%s\t%s\n' "${method}" "${url}" >> "${FAKE_CURL_LOG}"

status=200
case "${method} ${url}" in
	'PUT '*'/api/dashboards/'*)
		response='{"id":"openirn-api-health-security"}'
		;;
	'GET '*'/api/actions/connectors')
		response='[]'
		;;
	'POST '*'/api/actions/connector')
		response='{"id":"openirn-monitoring-kibana-log","connector_type_id":".server-log"}'
		;;
	'GET '*'/api/alerting/rule/'*)
		status=404
		response='{"statusCode":404,"error":"Not Found"}'
		;;
	'POST '*'/api/alerting/rule/'*)
		rule_id=${url##*/}
		printf -v response '{"id":"%s","rule_type_id":".es-query"}' "${rule_id}"
		;;
	*)
		echo "Requête simulée inattendue : ${method} ${url}" >&2
		exit 2
		;;
esac

if [[ -n ${output} ]]; then
	printf '%s\n' "${response}" > "${output}"
else
	printf '%s\n' "${response}"
fi
if [[ ${write_out} == '%{http_code}' ]]; then
	printf '%s' "${status}"
fi
