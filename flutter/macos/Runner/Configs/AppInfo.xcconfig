// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = OpenIRN

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = io.archoad.openirn

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Michel Dubois / Archoad.

// Defaults used outside the App Store CI job.
OPENIRN_CODE_SIGN_STYLE = Automatic
OPENIRN_CODE_SIGN_IDENTITY = Apple Development
OPENIRN_PROVISIONING_PROFILE_SPECIFIER =
OPENIRN_OTHER_CODE_SIGN_FLAGS =

// Generated only by the App Store CI job. Keeping this include target-scoped
// prevents Runner provisioning settings from leaking into Swift Package targets.
#include? "../../Flutter/ephemeral/CI-AppStore.xcconfig"
